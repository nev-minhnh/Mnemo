{
  "_note": "Telegram Web A (open source: github.com/Ajaxy/telegram-tt). Chat id is in the URL hash; messages are .Message[data-message-id], own messages have class 'own'.",
  "chat": {
    "key": {
      "from": "hash",
      "re": "^#(-?\\d+)"
    },
    "title": [
      {
        "sel": ".MiddleHeader .ChatInfo .fullName"
      },
      {
        "sel": ".MiddleHeader .ChatInfo .title"
      },
      {
        "sel": ".MiddleHeader h3"
      }
    ],
    "groupKeyRe": "^-"
  },
  "message": {
    "sel": ".MessageList .Message[data-message-id]",
    "key": {
      "attr": "data-message-id"
    },
    "text": {
      "sel": ".text-content",
      "exclude": [
        ".MessageMeta",
        ".Reactions",
        ".message-reactions",
        ".message-time"
      ]
    },
    "sender": {
      "sel": ".message-title-name"
    },
    "inheritSender": true,
    "time": {
      "sel": ".message-time"
    },
    "outgoing": {
      "selfClass": "own"
    },
    "recalled": []
  },
  "media": {
    "sel": "img.full-media[src^='blob:'], video[src^='blob:'], .media-inner img[src^='blob:']",
    "minSize": 80
  },
  "unreadDivider": ".MessageList .unread-divider",
  "compose": {
    "sel": "#editable-message-text"
  },
  "selfAvatar": [
    {
      "sel": "#LeftColumn .ProfileInfo img.avatar-media, #LeftColumn .ProfileInfo .ProfilePhoto img:not(.thumb), #Settings .ProfileInfo img.avatar-media",
      "not": "#RightColumn, #MiddleColumn"
    },
    {
      "sel": ".settings-content .ProfileInfo img, .settings-main-menu .ProfileInfo img",
      "not": "#RightColumn, #MiddleColumn"
    }
  ],
  "chatList": {
    "sel": ".chat-list .ListItem .fullName"
  },
  "unreadChats": {
    "row": ".chat-list .ListItem.Chat",
    "badge": ".ChatBadge.unread, .ChatBadge:not(.pinned):not(.mention)",
    "name": {
      "sel": ".fullName"
    }
  },
  "_avatarNote": "Telegram Web shows your own photo only in Settings (☰ → Settings); Mnemo picks it up the first time that screen is open and keeps it.",
  "unreadCount": [
    {
      "sel": ".chat-list .ChatBadge:not(.muted):not(.pinned)",
      "not": ".muted, .ChatBadge.mention, .ChatBadge.reaction",
      "mode": "sum",
      "zeroIsOne": true,
      "listSel": ".chat-list"
    }
  ],
  "_unreadNote": "unreadCount: the unread-message total is the sum of the chat list's badges (muted chats left out), not the page title. Only conversations the list has drawn are counted; scrolled-away ones aren't."
}
