{
  "_note": "WhatsApp Web. Message rows carry data-id = \"<true|false>_<chat jid>_<message id>\". Copy this file to services\\whatsapp.json in Mnemo's config folder to override any field.",
  "chat": {
    "key": {
      "from": "message",
      "attr": "data-id",
      "re": "^(?:true|false)_([^_]+@[a-z.]+)_"
    },
    "title": [
      {
        "sel": "#main header span[dir='auto']",
        "attr": "title"
      },
      {
        "sel": "#main header span[dir='auto']"
      }
    ],
    "groupKeyRe": "@g\\.us$"
  },
  "message": {
    "sel": "#main div[data-id]",
    "key": {
      "attr": "data-id"
    },
    "text": {
      "sel": "div.copyable-text span.selectable-text"
    },
    "sender": {
      "sel": "div.copyable-text",
      "attr": "data-pre-plain-text",
      "re": "\\]\\s*(.+?):\\s*$"
    },
    "time": {
      "sel": "div.copyable-text",
      "attr": "data-pre-plain-text",
      "re": "^(\\[[^\\]]+\\])"
    },
    "timeParse": "whatsapp",
    "outgoing": {
      "keyRe": "^true_"
    },
    "recalled": [
      "This message was deleted",
      "You deleted this message",
      "Tin nhắn này đã bị xóa",
      "Bạn đã xóa tin nhắn này"
    ]
  },
  "media": {
    "sel": "img[src^='blob:'], video[src^='blob:'], audio[src^='blob:']",
    "minSize": 80
  },
  "compose": {
    "sel": "footer div[contenteditable='true']"
  },
  "selfAvatar": [
    {
      "sel": "#side header img[src]"
    },
    {
      "sel": "header img[src]"
    }
  ],
  "chatList": {
    "sel": "#pane-side span[title]"
  },
  "unreadChats": {
    "row": "#pane-side div[role='listitem'], #pane-side div[role='row']",
    "badge": "span[aria-label*='unread' i], span[aria-label*='chưa đọc' i]",
    "name": {
      "sel": "span[title]",
      "attr": "title"
    }
  }
}
