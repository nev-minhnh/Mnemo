{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "services",
  "description": "The apps' own pages: only saving what they show, handing over notifications and opening the writing popup.",
  "webviews": [
    "acc-*"
  ],
  "remote": {
    "urls": [
      "https://web.whatsapp.com/*",
      "https://web.telegram.org/*",
      "https://*.facebook.com/*",
      "https://www.instagram.com/*",
      "https://chat.zalo.me/*",
      "https://discord.com/*",
      "https://web.wechat.com/*",
      "https://wx.qq.com/*",
      "https://wx2.qq.com/*",
      "https://www.threads.com/*",
      "https://www.threads.net/*",
      "https://app.slack.com/*",
      "https://*.slack.com/*",
      "https://www.linkedin.com/*"
    ]
  },
  "permissions": [
    "allow-mnemo-config",
    "allow-mnemo-log",
    "allow-mnemo-context",
    "allow-mnemo-senders",
    "allow-mnemo-crop",
    "allow-mnemo-ingest",
    "allow-mnemo-media-blob",
    "allow-mnemo-media-url",
    "allow-mnemo-assist-open",
    "allow-mnemo-assist-check",
    "allow-mnemo-profile",
    "allow-mnemo-notify"
  ]
}
